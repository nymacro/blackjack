cabal-version:       2.4
name:                mmaker
version:             0.1.0.0
synopsis:            Simple Matchmaking Server
description:         Please see README.md
homepage:            https://github.com/nymacro/mmaker#readme
license:             BSD-3-Clause
license-file:        LICENSE
author:              Aaron Marks
maintainer:          nymacro@gmail.com
copyright:           2016 Aaron Marks
category:            Web
build-type:          Simple
tested-with:         GHC == 9.10.3

library
  exposed-modules:     Game.Blackjack
                     , App.Blackjack
                     , App.Common
                     , App.Config
                     , App.Matchmake
  other-extensions:    OverloadedStrings
  build-depends:       base >= 4.7 && < 5
                     , random
                     , aeson
                     , containers
                     , text
                     , websockets
                     , unagi-chan
                     , uuid
                     , async
                     , bytestring
                     , stm
  default-language:    Haskell2010
  hs-source-dirs:      src

executable mmaker
  hs-source-dirs:      app
  main-is:             Main.hs
  default-language:    Haskell2010
  ghc-options:         -Wall -threaded -rtsopts=all
  build-depends:       base >= 4.7 && < 5
                     , mmaker
                     , warp
                     , wai
                     , wai-websockets
                     , wai-extra
                     , wai-middleware-static
                     , scotty
                     , text
                     , random
                     , aeson
                     , containers
                     , websockets
                     , unagi-chan
                     , uuid
                     , async
                     , bytestring
                     , stm

test-suite test
  type:                exitcode-stdio-1.0
  hs-source-dirs:      tests
  main-is:             TestMain.hs
  other-modules:       Game.BlackjackSpec
  default-language:    Haskell2010
  ghc-options:         -Wall
  build-tool-depends:  hspec-discover:hspec-discover
  build-depends:       base
                     , mmaker
                     , hspec
                     , QuickCheck
                     , random
                     , aeson
                     , containers
                     , text
                     , websockets
                     , unagi-chan
                     , uuid
                     , async
                     , bytestring
                     , stm
